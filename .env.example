VITE_API_URL=http://localhost:4000/api

# Cloudinary — used for avatar and product image uploads.
# Get these from https://cloudinary.com (Dashboard for cloud name,
# Settings > Upload > Upload presets for the preset — set it to "Unsigned").
# Neither value is secret; both are safe in frontend code.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Cloudinary (for avatar and product image uploads) — see frontend README
# for setup steps. Leave blank to keep using manually-placed image files.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
